ignore-workspace-root-check=true
# Hoist React/antd so host and module-federation remotes resolve a single copy.
public-hoist-pattern[]=*react*
public-hoist-pattern[]=antd
public-hoist-pattern[]=@module-federation/*
# Dedupe runtime deps of source-consumed framework packages. (Apps that bundle
# @octopus/core-app-api also declare i18next/zen-observable directly, which is
# what actually makes the bundler resolve them.)
public-hoist-pattern[]=i18next
public-hoist-pattern[]=zen-observable
